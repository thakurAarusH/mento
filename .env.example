# Copy to .env (or export in your shell). Placeholders only.
MASTER_PASSPHRASE=change-me-long-random
PORT=3000
# Public HTTPS URL if using a tunnel (used inside QR codes). Leave empty on LAN.
PUBLIC_URL=
DATA_DIR=./data
MAX_VIDEO_MB=200
MAX_RECORDING_SEC=600
MAX_FRAME_KB=400
SNAPSHOT_INTERVAL_MS=3500
RETENTION_DAYS=30
TOKEN_TTL_HOURS=24
# Optional local AI (Ollama). Without these, AI analysis is reported as unavailable (never faked).
OLLAMA_URL=
OLLAMA_VISION_MODEL=
# Only set to 1 if you knowingly allow footage to be sent to a non-local Ollama host.
OLLAMA_ALLOW_REMOTE=0
