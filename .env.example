# Copy to .env (or export in your shell). Placeholders only.
# Administrator/setup passphrase (sees every master's sessions). Masters normally sign in with their own account.
MASTER_PASSPHRASE=change-me-long-random
PORT=3000
# Public HTTPS URL if using a tunnel (used inside QR codes). Leave empty on LAN.
PUBLIC_URL=
DATA_DIR=./data
MAX_VIDEO_MB=200
MAX_RECORDING_SEC=600
MAX_FRAME_KB=400
SNAPSHOT_INTERVAL_MS=3500
RETENTION_DAYS=30
TOKEN_TTL_HOURS=24
# Optional local AI (Ollama). Without these, AI analysis is reported as unavailable (never faked).
OLLAMA_URL=
OLLAMA_VISION_MODEL=
# Only set to 1 if you knowingly allow footage to be sent to a non-local Ollama host.
OLLAMA_ALLOW_REMOTE=0
# Local AI pacing (defaults shown). Pause between frames keeps the desktop responsive; slow frames are retried once, then skipped.
AI_FRAME_PAUSE_MS=1500
AI_FRAME_TIMEOUT_MS=90000
AI_MAX_FRAMES=24
AI_FRAME_WIDTH=512
AI_MAX_TOKENS=1536
# Optional local speech-to-text for the master's spoken answers (whisper.cpp, runs on the CPU; audio never leaves this computer).
WHISPER_BIN=
WHISPER_MODEL=
WHISPER_LANG=auto
WHISPER_THREADS=4
# ---- Optional hybrid AI (off by default; the local models above always stay as the fallback) ----
# text   = Claude writes/judges questions, Japanese, record drafts and reply suggestions from TEXT only
#          (frame descriptions made locally, the master's words, approved records). Photos and video never leave.
# vision = also sends still frames and student practice photos (better analysis; more data leaves this computer).
# The privacy page, consent screens and landing page change their wording automatically when this is on.
CLOUD_AI=off
# Key from console.anthropic.com. Stays on this server: never sent to browsers, scrubbed from errors. Keep .env chmod 600.
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default, best), claude-sonnet-5-5 (fast, strong Japanese), claude-haiku-5-5 (cheapest, fastest).
CLOUD_MODEL=claude-opus-5-5
# low (default) keeps answers fast; medium/high think longer.
CLOUD_EFFORT=low
CLOUD_TIMEOUT_MS=30000
# Optional cloud speech-to-text for spoken answers: any OpenAI-compatible /audio/transcriptions endpoint.
# e.g. OpenAI (gpt-4o-transcribe) or Groq (https://api.groq.com/openai/v1/audio/transcriptions, whisper-large-v3-turbo).
CLOUD_STT=0
CLOUD_STT_URL=https://api.openai.com/v1/audio/transcriptions
CLOUD_STT_KEY=
CLOUD_STT_MODEL=gpt-4o-transcribe
# Check the settings with one tiny request each: npm run cloud-check
# Allow anyone who can open the site to create a master account (1, default) or not (0).
ALLOW_SIGNUP=1
# Local text-to-speech for read-aloud guidance on the student phone (optional; audio never leaves this computer).
# Japanese: Open JTalk + an HTS voice (README → "Japanese"). English: espeak-ng (auto-detected at /usr/bin/espeak-ng).
OPENJTALK_BIN=
OPENJTALK_DIC=
OPENJTALK_VOICE=
ESPEAK_BIN=
# cloudflared --metrics address; when set, the quick tunnel's current address is used for QR codes and links.
TUNNEL_METRICS=
# 1 = restart the tunnel service (TUNNEL_SERVICE, default mento-tunnel) when the public address stops answering.
TUNNEL_SELFHEAL=
